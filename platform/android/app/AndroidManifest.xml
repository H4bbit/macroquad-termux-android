<?xml version="1.0" encoding="utf-8"?>
<manifest
    package="org.h4bbit.macroquad"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <!-- miniquad creates an ES2 EGL context even on newer devices -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <!-- miniquad's own Activity (not NativeActivity): it creates the
             QuadSurface and calls System.loadLibrary, which in turn calls
             quad_main() inside the .so. Recreating the Activity would call
             quad_main again through QuadNative.activityOnCreate while the
             previous loop is still running, so configChanges covers every
             change that usually recreates the screen. -->
        <activity
            android:name="org.h4bbit.macroquad.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
